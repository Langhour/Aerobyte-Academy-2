# Copy this file to .env and fill in the values before deploying.

# ── Admin Account ──────────────────────────────────────────────────────────
ADMIN_EMAIL=aerobyte.academy@gmail.com

# Generate with: python3 backend/create_admin_hash.py
# Default password: @aerobyte168
ADMIN_PASSWORD_HASH=pbkdf2_sha256$310000$3cf7e01e94449bdfe1f40b342b0cd59c$7765c6aa594d39437b5db400fd76519b50278faf503758b01b586ea38754961f

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_SESSION_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET
ADMIN_COOKIE_SECURE=true

# ── Public Domain ──────────────────────────────────────────────────────────
# Replace with your actual domain or Oracle Cloud public IP
# Examples:
#   FRONTEND_URL=https://aerobyte.yourdomain.com
#   FRONTEND_URL=https://129.xxx.xxx.xxx.nip.io  (free wildcard DNS via nip.io)
FRONTEND_URL=https://YOUR_DOMAIN_HERE
FRONTEND_ORIGINS=https://YOUR_DOMAIN_HERE

# ── Email: Resend (Primary) ───────────────────────────────────────────────
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM=AeroByte Academy <onboarding@resend.dev>

# ── Optional: Google OAuth ────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Optional: Database ────────────────────────────────────────────────────
# Leave blank to use SQLite (default). Set for PostgreSQL.
DATABASE_URL=

# ── Production ─────────────────────────────────────────────────────────────
DEV_EMAIL_FALLBACK=false
