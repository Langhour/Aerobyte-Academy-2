# Copy to hosting/.env before starting with Docker Compose.
ADMIN_EMAIL=admin@example.com
# Generate with: cd backend; .venv\Scripts\python.exe create_admin_hash.py
ADMIN_PASSWORD_HASH=replace-with-generated-pbkdf2-sha256-hash
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
# Set these to the public HTTPS site origin for production.
FRONTEND_ORIGINS=https://your-domain.example
ADMIN_COOKIE_SECURE=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FRONTEND_URL=http://localhost:8080
# Resend API settings for transactional emails (password reset, email verification)
RESEND_API_KEY=
EMAIL_FROM=AeroByte Academy <onboarding@resend.dev>
# Optional fallback: EmailJS
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
WEB_PORT=8080
